DATABASE_URL=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MODEL_PATH=models/flood_model_final.joblib
SCALER_PATH=models/scaler_final.joblib
FEATURE_COLS_PATH=models/feature_cols_final.joblib
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
NAIROBI_LAT=-1.286389
NAIROBI_LON=36.817223
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Selected v1: isolated native runtime and research replay; no live promotion.
MODEL_V1_DIR=models/nextday-proxy-v1
MODEL_V1_DATA_DIR=data/model_v1
MODEL_V1_PYTHON=.venv-model-v1/Scripts/python.exe
# Safe API startup; explicit migration/worker commands are documented in the runbook.
AUTO_CREATE_LEGACY_TABLES=false
LEGACY_SCHEDULER_ENABLED=false

# Source stores and the staff-only binary rainfall research runtime.
# On Linux override model interpreter paths with the matching virtualenv bin/python.
OPERATIONAL_SOURCE_STORE=data/operational_sources
MONITORING_POINT_SOURCE_STORE=data/hotspots/point_weather
# true: the API collects weather itself every interval (hourly at minute 5 UTC)
MONITORING_POINT_COLLECTION_AUTOMATED=true
MONITORING_POINT_COLLECTION_INTERVAL_HOURS=1
# Stage 1 rule: NASA IMERG Early observed rain. Credentials here or in ~/.netrc (urs.earthdata.nasa.gov).
IMERG_EARLY_ENABLED=true
IMERG_EARLY_STORE=data/hotspots/imerg_early
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
BINARY_RAINFALL_MODEL_DIR=models/nextday-rainfall-binary-v1
BINARY_RAINFALL_PYTHON=.venv-model-v1/Scripts/python.exe
# Route checker: free key from https://openrouteservice.org/dev/#/signup (server-side only)
OPENROUTESERVICE_API_KEY=
# Citizen report photos (personal data; back up with the database)
REPORT_PHOTO_DIR=data/report_photos
