# Backend origin (no trailing /dashboard). Vite reads these at startup/build time.
VITE_API_BASE_URL=http://localhost:8000

# Check persisted predictions every minute; the backend runs inference hourly.
VITE_PREDICTION_POLL_INTERVAL_MS=60000

# One hourly cycle plus a five-minute grace period.
VITE_PREDICTION_STALE_AFTER_MS=3900000
