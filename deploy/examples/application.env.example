# INERT TEMPLATE. Empty secrets must be filled privately; never commit the result.
DATABASE_URL=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=production
# Every address the dashboard is served from, comma-separated (domain, www, Netlify site).
FRONTEND_URL=https://example.co.ke,https://www.example.co.ke,https://your-site.netlify.app
AUTO_CREATE_LEGACY_TABLES=false
LEGACY_SCHEDULER_ENABLED=false
OPERATIONAL_SOURCE_STORE=/var/lib/nairobifloodwatch/operational_sources
MONITORING_POINT_SOURCE_STORE=/var/lib/nairobifloodwatch/point_weather
# The API collects forecast + observed rain itself every interval (minute 5, UTC); no timer needed.
# Collection only: no alerts, no prediction records. Status: admin System status page.
MONITORING_POINT_COLLECTION_AUTOMATED=true
MONITORING_POINT_COLLECTION_INTERVAL_HOURS=1
# Stage 1 rule: observed antecedent rain from NASA IMERG Early. Needs a NASA Earthdata account.
IMERG_EARLY_ENABLED=true
IMERG_EARLY_STORE=/var/lib/nairobifloodwatch/imerg_early
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
MODEL_V1_DIR=models/nextday-proxy-v1
MODEL_V1_DATA_DIR=data/model_v1
MODEL_V1_PYTHON=/srv/nairobifloodwatch/.venv-model-v1/bin/python
# Staff-only on-demand binary rainfall research model; never an alert service.
BINARY_RAINFALL_MODEL_DIR=models/nextday-rainfall-binary-v1
BINARY_RAINFALL_PYTHON=/srv/nairobifloodwatch/.venv-model-v1/bin/python
# Route checker: free key from https://openrouteservice.org/dev/#/signup (server-side only)
OPENROUTESERVICE_API_KEY=
# Citizen report photos (personal data; back up with the database)
REPORT_PHOTO_DIR=/var/lib/nairobifloodwatch/report_photos
